{
  "swagger": "2.0",
  "info": {
    "title": "Fourth Zendesk Ideas MCP (Dev)",
    "description": "Community Ideas MCP Server — pre-computed data, no auth required. Browse, search, and analyze Zendesk Community Ideas.",
    "version": "1.0.0"
  },
  "host": "fourth-zendesk-mcp-ideas-dev.bluewave-95f931ef.northeurope.azurecontainerapps.io",
  "basePath": "/",
  "schemes": ["https"],
  "paths": {
    "/mcp": {
      "post": {
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "type": "string",
            "required": true,
            "default": "application/json",
            "x-ms-visibility": "internal"
          },
          {
            "name": "Accept",
            "in": "header",
            "type": "string",
            "required": true,
            "default": "application/json, text/event-stream",
            "x-ms-visibility": "internal"
          }
        ],
        "responses": {
          "200": {
            "description": "MCP Response"
          }
        },
        "operationId": "InvokeServer",
        "summary": "Invoke MCP Server",
        "description": "Send JSON-RPC requests to the MCP server. Supports Streamable HTTP transport."
      }
    },
    "/sse": {
      "get": {
        "responses": {
          "200": {
            "description": "SSE stream"
          }
        },
        "operationId": "SSEConnect",
        "summary": "SSE Connection",
        "description": "Server-Sent Events endpoint for legacy MCP clients."
      }
    }
  },
  "securityDefinitions": {},
