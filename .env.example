# Set either ZENDESK_SUBDOMAIN or ZENDESK_BASE_URL.
ZENDESK_SUBDOMAIN=your-subdomain
# ZENDESK_BASE_URL=https://your-subdomain.zendesk.com
ZENDESK_EMAIL=your-email@example.com
ZENDESK_API_TOKEN=your-api-token

# Transport: "stdio" (default, for local IDE) or "http" (for remote/Azure deployment)
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=http)
MCP_HTTP_PORT=8000
MCP_HTTP_HOST=0.0.0.0

# Tool filtering: comma-separated list of tool names to disable
DISABLED_TOOLS=

# Rate limiting: max Zendesk API calls per minute (default 200)
ZENDESK_RATE_LIMIT=200
