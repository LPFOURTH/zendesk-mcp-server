# Set either ZENDESK_SUBDOMAIN or ZENDESK_BASE_URL.
ZENDESK_SUBDOMAIN=your-subdomain
# ZENDESK_BASE_URL=https://your-subdomain.zendesk.com
ZENDESK_EMAIL=your-email@example.com
ZENDESK_API_TOKEN=your-api-token

# Transport: "stdio" (default, for local IDE) or "http" (for remote/Azure deployment)
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=http)
MCP_HTTP_PORT=8000
MCP_HTTP_HOST=0.0.0.0

# Tool filtering: comma-separated list of tool names to disable
DISABLED_TOOLS=

# Rate limiting: max Zendesk API calls per minute (default 200)
ZENDESK_RATE_LIMIT=200

# --- Persistent OAuth storage (Cosmos DB) ---
# Used only by /mcp/dev (Architecture C). When unset, falls back to FastMCP's
# default file-based storage (wiped on each deploy).
# Generate keys with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Cosmos endpoint:
#   - prod/dev Azure: https://fourth-mcp-cosmos.documents.azure.com:443/
COSMOS_ENDPOINT=

# 32-byte urlsafe-base64 Fernet key (must stay constant across deploys)
MCP_STORAGE_ENCRYPTION_KEY=

# Same format as MCP_STORAGE_ENCRYPTION_KEY; signs FastMCP-issued JWTs.
# Already used by Architecture C; persistence here means it must NOT be
# regenerated on each deploy.
MCP_JWT_SIGNING_KEY=
